<footer class="shusha-footer page-width">
  <div class="shusha-footer__grid">
    <div>
      <strong class="shusha-footer__brand">SHUSHA</strong>
      <div class="shusha-footer__description rte">{{ section.settings.description }}</div>
      {% if settings.shusha_business_name != blank or settings.shusha_business_address_line1 != blank %}
        <div class="shusha-footer__company">
          {% if settings.shusha_business_name != blank %}<p>{{ settings.shusha_business_name | escape }}</p>{% endif %}
          {% render 'shusha-company-address' %}
        </div>
      {% endif %}
    </div>
    <div>
      <p class="shusha-footer__heading">Good to know</p>
      <nav aria-label="Customer information">
        {%- assign footer_menu_urls = '|' -%}
        {% for link in section.settings.menu.links %}
          {%- capture footer_link_url -%}{%- render 'shusha-link-url', link: link -%}{%- endcapture -%}
          {%- assign footer_link_url = footer_link_url | strip -%}
          {% if footer_link_url != blank %}
            <a class="link" href="{{ footer_link_url | escape }}">{{ link.title | escape }}</a>
            {%- assign footer_menu_urls = footer_menu_urls | append: footer_link_url | append: '|' -%}
          {% endif %}
        {% endfor %}
        {%- assign company_page_handles = 'about,contact,how-to-order' | split: ',' -%}
        {% for company_page_handle in company_page_handles %}
          {% assign company_page = pages[company_page_handle] %}
          {% assign company_page_url_token = company_page.url | prepend: '|' | append: '|' %}
          {% if company_page != blank %}{% unless footer_menu_urls contains company_page_url_token %}<a class="link" href="{{ company_page.url }}">{{ company_page.title | escape }}</a>{% endunless %}{% endif %}
        {% endfor %}
        {%- assign shipping_page = pages['shipping-payment'] | default: pages.shipping | default: pages['shipping-policy'] -%}
        {%- assign shipping_page_url_token = shipping_page.url | prepend: '|' | append: '|' -%}
        {% if shipping_page != blank %}{% unless footer_menu_urls contains shipping_page_url_token %}<a class="link" href="{{ shipping_page.url }}">{{ shipping_page.title | escape }}</a>{% endunless %}{% endif %}
        {%- assign payment_page = pages.payment | default: pages['payment-methods'] -%}
        {%- assign payment_page_url_token = payment_page.url | prepend: '|' | append: '|' -%}
        {% if payment_page != blank and payment_page.url != shipping_page.url %}{% unless footer_menu_urls contains payment_page_url_token %}<a class="link" href="{{ payment_page.url }}">{{ payment_page.title | escape }}</a>{% endunless %}{% endif %}
      </nav>
    </div>
    <div class="shusha-footer__support">
      <p class="shusha-footer__heading">Let’s talk</p>
      {% render 'shusha-contact-actions', compact: true %}
      <span class="shusha-brand-link">{% render 'shusha-brand-icon', brand: 'wise' %}Wise / bank transfer after confirmation</span>
    </div>
  </div>
  <p class="shusha-footer__bottom caption">&copy; {{ 'now' | date: '%Y' }} SHUSHA</p>
</footer>
{% schema %}
{
  "name": "SHUSHA footer",
  "settings": [
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Clothing from Sri Lanka, with personal support for worldwide order requests.</p>" },
    { "type": "link_list", "id": "menu", "label": "Customer information menu", "default": "footer" }
  ]
}
{% endschema %}
