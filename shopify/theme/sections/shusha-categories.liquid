{%- assign shusha_has_categories = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.collection != blank and block.settings.collection.all_products_count > 0 -%}
    {%- assign shusha_has_categories = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{% if shusha_has_categories %}
<section class="shusha-categories page-width" aria-labelledby="ShushaCategories-{{ section.id }}">
  <h2 class="shusha-section-title h1" id="ShushaCategories-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  <div class="shusha-category-grid">
    {% for block in section.blocks %}
      {% assign category = block.settings.collection %}
      {% if category != blank and category.all_products_count > 0 %}
        {% assign category_image = category.image | default: category.products.first.featured_image %}
        <a class="shusha-category" href="{{ category.url | escape }}" {{ block.shopify_attributes }}>
          {% if category_image != blank %}
            <span class="shusha-category__image">
              {{ category_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 750px) 33vw, 32vw' }}
            </span>
          {% endif %}
          <span class="shusha-category__label">{{ category.title | escape }}<span aria-hidden="true">↗</span></span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}
{% schema %}
{
  "name": "SHUSHA categories",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Find your style" }],
  "blocks": [{ "type": "collection", "name": "Collection", "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }] }],
  "max_blocks": 3,
  "presets": [{ "name": "SHUSHA categories" }]
}
{% endschema %}
