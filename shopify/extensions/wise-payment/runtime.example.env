# Private backend runtime only. Never put these values in the UI extension,
# theme, a Shopify metafield or tracked configuration.
SHOPIFY_APP_URL=
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_SCOPES=
SHOPIFY_PAYMENT_ACCESS_SECRET=
SHOPIFY_MANUAL_GATEWAYS=
# Reviewed JSON lists, e.g. actual manual gateway names and Location GIDs.
SHOPIFY_FULFILLMENT_LOCATION_IDS=
SHUSHA_WISE_RECEIVING_CONFIG=
# All switches default off. Enable each only after its separate acceptance.
SHOPIFY_BRIDGE_ENABLED=false
SHOPIFY_BRIDGE_WRITES_ENABLED=false
SHOPIFY_SHARED_CAPACITY_ENABLED=false
SHOPIFY_PAYMENT_OPERATIONS_ENABLED=false
SHOPIFY_ORDER_OPERATIONS_ENABLED=false
SHOPIFY_CONTENT_SYNC_ENABLED=false
# Order cancellation also requires shared-capacity and payment-operation gates.
