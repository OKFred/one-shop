# Backend only. Copy into a private runtime file; never commit populated values.
SHOPIFY_BRIDGE_ENABLED=false
SHOPIFY_BRIDGE_WRITES_ENABLED=false
SHOPIFY_SHOP=
SHOPIFY_APP_URL=
SHOPIFY_CLIENT_ID=
