# Backend only. Copy into a private runtime file; never commit populated values.
SHOPIFY_BRIDGE_ENABLED=false
SHOPIFY_BRIDGE_WRITES_ENABLED=false
SHOPIFY_BRIDGE_JOBS_ENABLED=false
SHOPIFY_SHARED_CAPACITY_ENABLED=false
SHOPIFY_INVENTORY_ACTIVATION_ENABLED=false
SHOPIFY_CATALOG_PUBLICATION_ENABLED=false
SHOPIFY_CONTENT_SYNC_ENABLED=false
SHOPIFY_PAYMENT_OPERATIONS_ENABLED=false
SHOPIFY_ORDER_OPERATIONS_ENABLED=false
SHOPIFY_MANUAL_GATEWAYS=[]
SHOPIFY_FULFILLMENT_LOCATION_IDS=[]
# Separate random secret of at least 32 characters, never reuse the app secret.
SHOPIFY_PAYMENT_ACCESS_SECRET=
SHOPIFY_LOCATION_ID=
SHOPIFY_PUBLICATION_ID=
SHOPIFY_SHOP=
SHOPIFY_APP_URL=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# 32-byte AES key, base64 encoded. Generate and preserve privately.
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_SCOPES=read_products,write_products,read_files,write_files,read_inventory,read_locations
# Later reviewed scopes: write_inventory,read_orders,write_orders,write_order_edits,
# read_customers,read_merchant_managed_fulfillment_orders,
# write_merchant_managed_fulfillment_orders,write_publications,write_content,
# write_online_store_navigation. Review actual merchant/protected-data access first.
